@model CodeClash.Models.ProjectSubmission

@{
    ViewData["Title"] = "Оценяване на проект";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-warning">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Оценяване на разработка</h4>
            </div>
            <div class="card-body">
                <p><strong>Проект:</strong> @Model.ProjectTitle</p>
                <p><strong>Отбор:</strong> @Model.Team?.TeamName</p>
                @if (!string.IsNullOrEmpty(Model.GitHubUrl))
                {
                    <p><strong>Код:</strong> <a href="@Model.GitHubUrl" target="_blank">Линк към GitHub</a></p>
                }

                <hr />

                <form asp-action="Score" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label for="score" class="form-label fw-bold">Оценка (0 - 100 точки):</label>
                        <input type="number" id="score" name="score" class="form-control" min="0" max="100" value="@Model.Score" required />
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
                        <button type="submit" class="btn btn-warning">Запази оценката</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>