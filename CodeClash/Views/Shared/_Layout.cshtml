<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - CodeClash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/CodeClash.styles.css" asp-append-version="true"/>
</head>
<body class="d-flex flex-column min-vh-100">
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">CodeClash</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Competitions" asp-action="Index">Състезания</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Teams" asp-action="Index">Отбори</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="ProjectSubmissions" asp-action="Index">Предадени проекти</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-primary" asp-area="" asp-controller="Leaderboard" asp-action="Index">Класиране</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container flex-grow-1 mb-5">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="mt-auto border-top bg-white py-4 shadow-sm">
        <div class="container">
            <div class="row align-items-center gy-3">
                <!-- Лява колона: Бранд и описание -->
                <div class="col-md-5 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <span class="badge bg-primary px-2 py-1 fw-bold rounded-2">#CC</span>
                        <span class="fw-bold text-dark fs-5 tracking-tight">CodeClash</span>
                    </div>
                    <p class="text-secondary small mb-0">
                        Платформа за състезания по програмиране, хакатони и оценяване на проекти в реално време.
                    </p>
                </div>

                <!-- Средна колона: Бързи връзки -->
                <div class="col-md-4 text-center">
                    <div class="d-flex justify-content-center gap-3 small">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary hover-primary">Начало</a>
                        <span class="text-muted">•</span>
                        <a asp-controller="Competitions" asp-action="Index" class="text-decoration-none text-secondary hover-primary">Състезания</a>
                        <span class="text-muted">•</span>
                        <a asp-controller="Teams" asp-action="Index" class="text-decoration-none text-secondary hover-primary">Отбори</a>
                        <span class="text-muted">•</span>
                        <a asp-controller="Leaderboard" asp-action="Index" class="text-decoration-none text-secondary hover-primary">Класиране</a>
                    </div>
                </div>

                <!-- Дясна колона: Версия и авторски права -->
                <div class="col-md-3 text-center text-md-end">
                    <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 small fw-normal mb-1">
                        ASP.NET Core 9.0
                    </span>
                    <div class="text-muted small">
                        &copy; @DateTime.UtcNow.Year CodeClash. Всички права запазени.
                    </div>
                </div>
            </div>
        </div>
    </footer>
<style>
.hover-primary {
transition: color 0.2s ease;
}
.hover-primary:hover {
color: var(--bs-primary) !important;
}
</style>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>